# Same shape as .env.dev, pointed at a different target.
# This file exists to prove the framework is environment-agnostic: swap
# UI_BASE_URL/API_BASE_URL here and every test in tests/ runs unmodified
# against a different environment. No test or page object reads these
# values directly -- they only ever go through framework/config/settings.py.
ENV=staging
UI_BASE_URL=https://www.saucedemo.com
UI_USERNAME=problem_user
UI_PASSWORD=secret_sauce
API_BASE_URL=https://reqres.in
API_KEY=reqres-free-v1
HEADLESS=true
TIMEOUT_MS=15000
